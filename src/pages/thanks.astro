---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent · Enamul Haq Chowdhury">
  <main id="main" class="container-x flex min-h-screen flex-col items-center justify-center text-center">
    <p class="font-mono text-sm text-accent">HTTP/1.1 202 Accepted</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-6xl">Message <span class="gradient-text">received</span>.</h1>
    <p class="mt-4 max-w-md text-muted">Thanks for reaching out. I'll get back to you as soon as I can.</p>
    <a href="/" class="btn btn-primary mt-8">Back to home</a>
  </main>
</Base>
