---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { projects } from '../data/profile';
---

<section id="projects" class="container-x py-24">
  <SectionHeading
    label="featured work"
    title="Systems I've designed and built."
    intro="Highlights from production work and research. Each card shows a simplified view of how data flows through the system."
  />

  <div class="grid gap-4 md:grid-cols-2">
    {
      projects.map((p, i) => (
        <article
          data-reveal
          style={`--delay: ${(i % 2) * 80}ms`}
          class:list={['card spotlight flex flex-col p-6 sm:p-7', i === 0 && 'md:col-span-2']}
        >
          <p class="font-mono text-xs text-faint">{p.kicker}</p>
          <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink sm:text-2xl">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{p.description}</p>

          {/* Mini architecture flow */}
          <div class="my-6 flex items-center overflow-x-auto rounded-xl border border-line bg-bg-soft/60 p-3" aria-label={`Flow: ${p.flow.join(' to ')}`}>
            {p.flow.map((node, j) => (
              <>
                <span class="shrink-0 rounded-lg border border-line-strong bg-surface-strong px-2.5 py-1.5 font-mono text-[11px] text-ink sm:text-xs">
                  {node}
                </span>
                {j < p.flow.length - 1 && (
                  <svg class="h-3 min-w-6 flex-1 text-accent" viewBox="0 0 40 8" preserveAspectRatio="none" aria-hidden="true">
                    <line x1="2" y1="4" x2="38" y2="4" stroke="currentColor" stroke-width="1.5" class="flow-line" />
                  </svg>
                )}
              </>
            ))}
          </div>

          <div class="mt-auto flex flex-wrap items-end justify-between gap-4">
            <div class="flex flex-wrap gap-2">
              {p.stack.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
            {p.metric && <span class="font-mono text-sm font-medium gradient-text">{p.metric}</span>}
          </div>

          {p.link && (
            <a href={p.link.href} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-1.5 text-sm text-accent hover:underline">
              {p.link.label} <Icon name="arrowUpRight" size={15} />
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
