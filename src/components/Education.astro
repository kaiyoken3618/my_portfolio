---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { education } from '../data/profile';
---

<section id="education" class="container-x py-24">
  <SectionHeading label="education" title="Foundations." />
  <div class="grid gap-4 md:grid-cols-2">
    {
      education.map((e, i) => (
        <div data-reveal style={`--delay: ${i * 80}ms`} class="card spotlight flex gap-4 p-6">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-line-strong bg-surface-strong text-accent">
            <Icon name="graduation" size={20} />
          </span>
          <div>
            <h3 class="font-semibold text-ink">{e.school}</h3>
            <p class="mt-1 text-sm text-muted">{e.degree}</p>
            {e.period && <p class="mt-1 font-mono text-xs text-faint">{e.period}</p>}
            <p class="mt-3 text-sm text-muted">{e.detail}</p>
            {e.link && (
              <a href={e.link} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm text-accent hover:underline">
                View IEEE paper <Icon name="arrowUpRight" size={15} />
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
