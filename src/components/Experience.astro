---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { experience } from '../data/profile';
---

<section id="experience" class="container-x py-24">
  <SectionHeading
    label="experience"
    title="Where I've shipped."
    intro="5+ years across government-scale platforms, e-commerce and distributed infrastructure. Open any role to see the details."
  />

  <ol class="relative ml-2 border-l border-line sm:ml-4">
    {
      experience.map((job, i) => (
        <li data-reveal style={`--delay: ${i * 60}ms`} class="relative pb-6 pl-6 sm:pl-10">
          <span
            class:list={[
              'absolute -left-[7px] top-6 h-3.5 w-3.5 rounded-full border-2',
              job.current ? 'border-accent bg-accent shadow-[0_0_0_4px_var(--glow-1)]' : 'border-line-strong bg-bg',
            ]}
          />
          <details class="card spotlight group" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 sm:p-6 [&::-webkit-details-marker]:hidden">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="text-lg font-semibold text-ink">{job.role}</h3>
                  {job.current && <span class="chip !border-accent/40 !text-accent">current</span>}
                </div>
                <p class="mt-1 text-sm text-muted">
                  <span class="text-ink">{job.company}</span> · {job.location}
                </p>
                <p class="mt-1 font-mono text-xs text-faint">{job.period}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted">{job.summary}</p>
              </div>
              <span class="mt-1 grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-line text-muted transition group-open:rotate-180 group-open:text-accent">
                <Icon name="chevronDown" size={16} />
              </span>
            </summary>
            <div class="px-5 pb-6 sm:px-6">
              <ul class="space-y-2.5 border-t border-line pt-5">
                {job.highlights.map((h) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-muted">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-5 flex flex-wrap gap-2">
                {job.stack.map((t) => (
                  <span class="chip">{t}</span>
                ))}
              </div>
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</section>
