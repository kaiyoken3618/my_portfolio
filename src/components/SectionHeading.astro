---
interface Props {
  label: string;
  title: string;
  intro?: string;
}
const { label, title, intro } = Astro.props;
---

<div data-reveal class="mb-12 max-w-2xl">
  <p class="section-label mb-3">// {label}</p>
  <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-base leading-relaxed text-muted">{intro}</p>}
</div>
